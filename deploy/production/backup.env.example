# Root-owned environment for agrolens-backup.service; install as mode 0600.
COMPOSE_ENV_FILE=/opt/agrolens/deploy/production/.env
# Use off-host or independently replicated storage; a path on this host is not a backup.
RESTIC_REPOSITORY=sftp:user@backup.example:/srv/restic/agrolens
RESTIC_PASSWORD_FILE=/etc/agrolens/restic-password
S3_APP_ACCESS_KEY=CHANGE_ME
S3_APP_SECRET_KEY=CHANGE_ME
BACKUP_MIN_FREE_BYTES=10737418240
# Optional evidence supplied by the release operator.
RELEASE_ID=production
