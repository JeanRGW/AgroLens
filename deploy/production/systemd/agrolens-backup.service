[Unit]
Description=AgroLens encrypted live backup
Requires=docker.service
After=docker.service
OnFailure=agrolens-backup-alert.service

[Service]
Type=oneshot
ExecStart=/opt/agrolens/deploy/production/agrolens-backup.sh
Environment=BACKUP_ENV_FILE=/etc/agrolens/backup.env
RuntimeDirectory=agrolens-backup
User=root
