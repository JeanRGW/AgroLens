# ──────────────────────────────────────────────────────────────────────────
# AgroLens — Production deployment environment
# Copy to `.env` and fill in every PLACEHOLDER before deploying.
# NEVER commit the resulting `.env` to version control.
#
# Topology (see deploy/production/README.md):
#   https://app.agrolens.rgw.app  -> web SPA  +  /api -> backend  +  /docs -> 404 (Swagger disabled)
#   https://s3.agrolens.rgw.app    -> Garage S3 API (public object endpoint)
#
# Only host Caddy and the Garage S3 endpoint are exposed publicly.
# PostgreSQL is NOT published to the host. Garage's admin API is internal-only.
# ──────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Internal to the Docker network; not exposed publicly.
POSTGRES_USER=postgres
# PLACEHOLDER — generate a URI-safe secret, e.g.: openssl rand -hex 24
# Avoid base64 here: it can contain '/' which breaks the DATABASE_URL below.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=agrolens
# Internal connection string used by api/worker containers.
# If POSTGRES_PASSWORD contains '/', ':', '@', '#', or '%', percent-encode it
# in this URL (e.g. '/' -> %2F).
DATABASE_URL=postgresql://postgres:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/agrolens

# ── Garage (S3-compatible) ────────────────────────────────────────────────
# Garage runtime secrets (passed to the `garage` container via GARAGE_* env
# vars; they are NOT stored in garage.toml.template). Garage v2.3.0 replaces
# the matching config.toml keys with these env values at runtime.
#
# PLACEHOLDER — generate: openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME_GARAGE_RPC_SECRET
# PLACEHOLDER — generate: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=CHANGE_ME_GARAGE_ADMIN_TOKEN
# PLACEHOLDER — generate: openssl rand -hex 32
GARAGE_METRICS_TOKEN=CHANGE_ME_GARAGE_METRICS_TOKEN
#
# Scoped application credentials. These are passed to Garage as
# GARAGE_DEFAULT_ACCESS_KEY/GARAGE_DEFAULT_SECRET_KEY (so `--single-node
# --default-bucket` creates the bucket+key with read+write+owner) AND used by
# the backend as S3_ACCESS_KEY/S3_SECRET_KEY. The backend applies bucket CORS
# on boot via these creds. Generate with openssl rand -hex 24 (URI-safe; no
# special characters).
S3_APP_ACCESS_KEY=CHANGE_ME_S3_APP_ACCESS_KEY
S3_APP_SECRET_KEY=CHANGE_ME_S3_APP_SECRET_KEY
S3_BUCKET=agrolens
S3_REGION=garage
# Server-side endpoint (Docker network). The API/worker talk to Garage here.
S3_ENDPOINT=http://garage:3900
# Public endpoint baked into presigned URLs (browser/mobile reachable).
S3_PUBLIC_ENDPOINT=https://s3.agrolens.rgw.app
# Exact origin(s) the inference service may fetch worker-generated model URLs from.
# Supports split DNS/private resolution; include scheme and explicit/default port.
INFERENCE_MODEL_DOWNLOAD_ORIGINS=http://garage:3900
# Path-style addressing keeps presigned URLs on the S3 subdomain root (no per-bucket vhost).
S3_FORCE_PATH_STYLE=true
# NOTE: the bucket CORS origin is now applied by the backend at boot from
# CORS_ORIGINS (below) — it must match the app domain served by Caddy
# (https://app.agrolens.rgw.app). Update both together and restart backend.

# ── Backend application ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api
# Keep false unless Swagger is protected by the reverse proxy.
SWAGGER_ENABLED=false
# Public self-registration is disabled; onboard users through an admin.
REGISTRATION_ENABLED=false
# Abandoned upload cleanup.
CLEANUP_DRAFT_EXPIRY_HOURS=24
CLEANUP_FAILED_RETENTION_DAYS=7
CLEANUP_BATCH_SIZE=20
# Canonical data-retention window (days) for worker pruning of expired rate
# limits, revoked/expired refresh tokens, completed/dead jobs,
# and old audit events. Deprecates INFERENCE_JOB_RETENTION_DAYS.
RETENTION_DAYS=7

# Comma-separated list of allowed browser origins (web + any other clients).
CORS_ORIGINS=https://app.agrolens.rgw.app

# ── Reverse Proxy ─────────────────────────────
# Hops the API may trust for X-Forwarded-* headers. Unset trusts one hop
# (host Caddy); see apps/api/.env.example for all accepted values.
TRUST_PROXY=1

# ── JWT / Authentication ───────────────────────────────────────────────────
# PLACEHOLDER — generate: openssl rand -hex 32  (min 32 chars, REQUIRED)
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ── Refresh Token Cookie (web clients) ─────────────────────────────────────
REFRESH_COOKIE_NAME=refresh_token
# Leave empty so the refresh cookie is scoped only to app.agrolens.rgw.app.
REFRESH_COOKIE_DOMAIN=
# Must be true in production (requires HTTPS).
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=lax

# ── Mail / Password Recovery ─────────────────────────────────────────────────
# Opt-in self-service password recovery. Keep MAIL_TRANSPORT=test ONLY outside
# production; production must use resend or smtp. Resend free tier is
# sufficient at this scale (https://resend.com).
# PLACEHOLDER — generate: openssl rand -hex 32
MAIL_ENABLED=false
# resend | smtp
MAIL_TRANSPORT=resend
MAIL_FROM=no-reply@agrolens.rgw.app
MAIL_FROM_NAME=AgroLens
MAIL_PASSWORD_RESET_TTL_MINUTES=30
# Required when MAIL_TRANSPORT=resend.
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
# Required when MAIL_TRANSPORT=smtp; ignored otherwise.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── First Admin Seed (db:seed:first-admin) ─────────────────────────────────
ADMIN_EMAIL=admin@example.com
# PLACEHOLDER — set a strong initial admin password.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FULL_NAME=Admin User
# ADMIN_PHONE=+550000000000
# Set to "true" to reset the password of an existing admin (revokes their
# refresh sessions). Without it, an existing user keeps their password.
# ADMIN_RESET_PASSWORD=true

# ── Upload Limits ────────────────────────────────────────────────────────────
UPLOAD_MAX_FILES=100
UPLOAD_MAX_FILE_SIZE_BYTES=104857600
UPLOAD_PRESIGNED_URL_TTL_SECONDS=900

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Per-endpoint IP buckets (@nestjs/throttler). Critical auth routes
# (login/register/refresh/forgot/reset/change-password) use THROTTLE_AUTH_*,
# everything else uses THROTTLE_DEFAULT_*.
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_MS=60000

# ── Worker ───────────────────────────────────────────────────────────────────
# Worker is enabled as its own container in docker-compose.prod.yml.
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
# Lease and retry controls; use a distinct WORKER_ID for every worker replica.
WORKER_LEASE_MS=120000
# Required by production Compose; set a unique value for every worker instance.
WORKER_ID=worker-production-unique-instance
WORKER_CLEANUP_INTERVAL_MS=60000
WORKER_QUEUE_AGE_THRESHOLD_MS=900000
WORKER_DEAD_JOB_THRESHOLD=1
WORKER_FINALIZATION_CONCURRENCY=1
WORKER_DELETION_CONCURRENCY=1
WORKER_INFERENCE_CONCURRENCY=1
WORKER_FINALIZATION_MAX_ATTEMPTS=3
WORKER_DELETION_MAX_ATTEMPTS=3

# ── Inference Service ─────────────────────────────────────────────────────────
# Opt-in AI. Disabled by default so a plain `docker compose up -d backend` is a
# complete app-only deployment (no inference worker loop, inference API routes
# return 503, web UI hides inference). To enable, set INFERENCE_ENABLED=true
# AND start the stack with `--profile ai`.
INFERENCE_ENABLED=false
# Internal Docker network URL for the Python FastAPI inference service.
# The worker reaches it at http://inference:8000 (service name).
INFERENCE_SERVICE_URL=http://inference:8000
# REQUIRED — generate a strong random secret, e.g.: openssl rand -hex 32
INFERENCE_API_KEY=CHANGE_ME_INFERENCE_API_KEY
# Maximum model file size accepted for upload/inspection, in bytes (500 MB default).
INFERENCE_MODEL_MAX_SIZE_BYTES=524288000
# Max number of temp files retained by the inference service.
INFERENCE_TEMP_MAX_FILES=20
# Max size per temp file, in bytes (25 MB default).
INFERENCE_TEMP_MAX_FILE_SIZE_BYTES=26214400
# Number of days to retain completed inference jobs in the DB.
# Deprecated alias of RETENTION_DAYS (kept for existing deployments); ignored
# when RETENTION_DAYS is set.
INFERENCE_JOB_RETENTION_DAYS=7
# Presigned upload URL expiry for model uploads, in hours.
INFERENCE_UPLOAD_EXPIRY_HOURS=24
# TTL (seconds) for cached downloaded images in the inference service.
INFERENCE_IMAGE_TTL_SECONDS=900
INFERENCE_PREDICT_MAX_SIZE_BYTES=26214400
IMAGE_MAX_INPUT_PIXELS=40000000
# Max retries per image for inference worker
WORKER_INFERENCE_MAX_IMAGE_ATTEMPTS=3
