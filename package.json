{
  "name": "agrolens",
  "private": true,
  "version": "1.0.0",
  "description": "Field image capture, upload processing, annotation, and YOLO dataset export for agriculture.",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,scss,css,html}\" \"!pnpm-lock.yaml\" --ignore-path .gitignore",
    "format:check": "turbo run format:check && prettier --check \"*.{ts,js,mjs,cjs,json,md,yml,yaml}\" \"!pnpm-lock.yaml\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
