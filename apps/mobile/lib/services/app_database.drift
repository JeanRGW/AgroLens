CREATE TABLE pending_uploads (
  id TEXT PRIMARY KEY NOT NULL,
  owner_id TEXT NOT NULL,
  images_json TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  activity_date INTEGER NOT NULL,
  status TEXT NOT NULL,
  error_message TEXT,
  property_id TEXT,
  talhao_id TEXT,
  crop_type_id TEXT,
  estadio_id TEXT,
  source TEXT,
  backend_upload_id TEXT,
  backend_status TEXT,
  backend_error TEXT,
  sync_error_code TEXT,
  sync_attempt_count INTEGER NOT NULL DEFAULT 0,
  last_sync_attempt_at INTEGER
);
CREATE INDEX idx_pending_uploads_owner_status ON pending_uploads(owner_id, status);

CREATE TABLE catalog_properties (
  id TEXT NOT NULL,
  owner_id TEXT NOT NULL,
  data TEXT NOT NULL,
  cached_at INTEGER NOT NULL,
  is_pending_sync INTEGER NOT NULL DEFAULT 0,
  sync_error TEXT,
  PRIMARY KEY (id, owner_id)
);
CREATE INDEX idx_catalog_properties_owner ON catalog_properties(owner_id);

CREATE TABLE catalog_talhoes (
  id TEXT NOT NULL,
  owner_id TEXT NOT NULL,
  data TEXT NOT NULL,
  cached_at INTEGER NOT NULL,
  is_pending_sync INTEGER NOT NULL DEFAULT 0,
  sync_error TEXT,
  PRIMARY KEY (id, owner_id)
);
CREATE INDEX idx_catalog_talhoes_owner ON catalog_talhoes(owner_id);

CREATE TABLE catalog_crop_types (
  id TEXT NOT NULL,
  owner_id TEXT NOT NULL,
  data TEXT NOT NULL,
  cached_at INTEGER NOT NULL,
  is_pending_sync INTEGER NOT NULL DEFAULT 0,
  sync_error TEXT,
  PRIMARY KEY (id, owner_id)
);
CREATE INDEX idx_catalog_crop_types_owner ON catalog_crop_types(owner_id);

CREATE TABLE catalog_estadios (
  id TEXT NOT NULL,
  owner_id TEXT NOT NULL,
  data TEXT NOT NULL,
  cached_at INTEGER NOT NULL,
  is_pending_sync INTEGER NOT NULL DEFAULT 0,
  sync_error TEXT,
  PRIMARY KEY (id, owner_id)
);
CREATE INDEX idx_catalog_estadios_owner ON catalog_estadios(owner_id);

CREATE TABLE pending_catalog_creates (
  temp_id TEXT NOT NULL,
  owner_id TEXT NOT NULL,
  entity_type TEXT NOT NULL,
  payload_json TEXT NOT NULL,
  normalized_name TEXT NOT NULL,
  parent_id TEXT,
  created_at INTEGER NOT NULL,
  error_message TEXT,
  PRIMARY KEY (temp_id, owner_id)
);
CREATE INDEX idx_pending_catalog_creates_owner ON pending_catalog_creates(owner_id);

CREATE TABLE catalog_id_mappings (
  temp_id TEXT NOT NULL,
  owner_id TEXT NOT NULL,
  server_id TEXT NOT NULL,
  entity_type TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  PRIMARY KEY (temp_id, owner_id)
);
CREATE INDEX idx_catalog_id_mappings_owner ON catalog_id_mappings(owner_id);
