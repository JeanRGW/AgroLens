# ──────────────────────────────────────────────
# AgroLens Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Enable Swagger locally. Keep disabled or protected in production.
SWAGGER_ENABLED=true
# Opt in to public self-registration for host-run local development.
REGISTRATION_ENABLED=false
# Abandoned upload cleanup.
CLEANUP_DRAFT_EXPIRY_HOURS=24
CLEANUP_FAILED_RETENTION_DAYS=7
CLEANUP_BATCH_SIZE=20
# Canonical data-retention window (days) for worker pruning of expired rate
# limits, revoked/expired refresh tokens, completed/dead jobs,
# and old audit events. Deprecates INFERENCE_JOB_RETENTION_DAYS.
RETENTION_DAYS=7

# ── Database (PostgreSQL) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrolens

# ── S3 / Garage Object Storage ──────────────
# S3_ENDPOINT: Server-side endpoint used by API/worker to talk to Garage.
# Use "http://garage:3900" when running inside Docker, "http://localhost:3900" on host.
S3_ENDPOINT=http://localhost:3900
# S3_PUBLIC_ENDPOINT: Endpoint baked into presigned URLs returned to clients
# (browser, mobile). Must be reachable from the client device — NOT a Docker
# internal hostname. When the API runs inside Docker, set this to
# http://localhost:3900 (or your production domain) so the browser can resolve it.
S3_PUBLIC_ENDPOINT=http://localhost:3900
# Region reported by the Garage S3 API (see deploy/garage.toml: s3_region).
S3_REGION=garage
# Dev S3 access key/secret. Auto-created by Garage (`--single-node
# --default-bucket`) using these same values as the default key; the backend
# applies bucket CORS on boot from CORS_ORIGINS. They match
# deploy/docker-compose.dev.yml (S3_ACCESS_KEY/S3_SECRET_KEY and GARAGE_DEFAULT_*).
S3_ACCESS_KEY=agrolens-dev-access-key
S3_SECRET_KEY=agrolens-dev-secret-key-change-me
S3_BUCKET=agrolens
S3_FORCE_PATH_STYLE=true

# ── CORS (comma-separated origins) ──────────
CORS_ORIGINS=http://localhost:4200

# ── JWT / Authentication ────────────────────
# JWT_SECRET: REQUIRED, min 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
# Access token TTL (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token TTL in days
JWT_REFRESH_EXPIRES_DAYS=30

# ── Refresh Token Cookie (web clients) ──────
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_DOMAIN=
# REFRESH_COOKIE_DOMAIN=  # Set for cross-subdomain; leave empty for same-site
# Set to 'true' in production (requires HTTPS)
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax

# ── Reverse Proxy ─────────────────────────────
# How many proxy hops the API may trust for X-Forwarded-* (client IP, proto).
# Default (unset) trusts one hop — the host Caddy in front of the API. Use
# "false" when clients connect directly, or a hop count for another topology.
TRUST_PROXY=1

# ── Mail / Password Recovery ──────────────────
# Opt-in email sending for self-service password recovery. Disabled by
# default; development can use MAIL_TRANSPORT=test (captures emails in
# memory, forbidden in production). Production uses resend or smtp.
MAIL_ENABLED=false
# resend | smtp | test
MAIL_TRANSPORT=smtp
# Sender address; required when MAIL_ENABLED=true.
MAIL_FROM=
MAIL_FROM_NAME=AgroLens
# Reset link validity window.
MAIL_PASSWORD_RESET_TTL_MINUTES=30
# Required when MAIL_TRANSPORT=resend (https://resend.com free tier).
RESEND_API_KEY=
# Required when MAIL_TRANSPORT=smtp.
SMTP_HOST=
SMTP_PORT=587
# Use true for implicit TLS (port 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── First Admin Seed (db:seed:first-admin) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_FULL_NAME=Admin User
# ADMIN_PHONE=+550000000000
# Set to "true" to reset the password of an existing admin (revokes their
# refresh sessions). Without it, an existing user keeps their password.
# ADMIN_RESET_PASSWORD=true

# ── Upload Limits ─────────────────────────────
# Max number of files per upload
UPLOAD_MAX_FILES=100
# Max file size in bytes (100 MB default)
UPLOAD_MAX_FILE_SIZE_BYTES=104857600
# Presigned upload URL TTL in seconds (15 min default)
UPLOAD_PRESIGNED_URL_TTL_SECONDS=900

# ── Rate Limiting ──────────────────────────
# Per-endpoint IP buckets (@nestjs/throttler). Critical auth routes
# (login/register/refresh/forgot/reset/change-password) use THROTTLE_AUTH_*,
# everything else uses THROTTLE_DEFAULT_*.
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_MS=60000

# ── Worker ────────────────────────────────────
# Set to 'true' to enable the worker process
WORKER_ENABLED=false
# Poll interval in milliseconds
WORKER_POLL_INTERVAL_MS=5000
WORKER_CLEANUP_INTERVAL_MS=60000
WORKER_QUEUE_AGE_THRESHOLD_MS=900000
WORKER_DEAD_JOB_THRESHOLD=1
WORKER_FINALIZATION_CONCURRENCY=1
WORKER_DELETION_CONCURRENCY=1
WORKER_INFERENCE_CONCURRENCY=1
# Lease duration; set a unique WORKER_ID per process or omit it for runtime host/pid/UUID generation.
WORKER_LEASE_MS=120000
WORKER_ID=worker-development-instance
# WORKER_ID=worker-hostname-unique-instance
# Max attempts before marking upload as failed
WORKER_FINALIZATION_MAX_ATTEMPTS=3
WORKER_DELETION_MAX_ATTEMPTS=3

# ── Inference Service ─────────────────────────
# Opt-in AI. Disabled by default so a default `docker compose up` (no
# `--profile ai`) is app-only; enable with true + the ai profile.
INFERENCE_ENABLED=false
# Base URL of the Python FastAPI inference service (Docker internal or localhost).
INFERENCE_SERVICE_URL=http://localhost:8000
# Development-only placeholder; use a strong secret in production.
INFERENCE_API_KEY=dev-only-inference-key-change-me
# Exact storage origin used by worker-generated model URLs (no paths or credentials).
INFERENCE_MODEL_DOWNLOAD_ORIGINS=http://localhost:3900
# Maximum model file size accepted for upload/inspection, in bytes (500 MB default).
INFERENCE_MODEL_MAX_SIZE_BYTES=524288000
# Max number of temp files retained by the inference service.
INFERENCE_TEMP_MAX_FILES=20
# Max size per temp file, in bytes (25 MB default).
INFERENCE_TEMP_MAX_FILE_SIZE_BYTES=26214400
# Number of days to retain completed inference jobs in the DB.
# Deprecated alias of RETENTION_DAYS (kept for existing deployments); ignored
# when RETENTION_DAYS is set.
INFERENCE_JOB_RETENTION_DAYS=7
# Presigned upload URL expiry for model uploads, in hours.
INFERENCE_UPLOAD_EXPIRY_HOURS=24
# TTL (seconds) for cached downloaded images in the inference service.
INFERENCE_IMAGE_TTL_SECONDS=900
INFERENCE_PREDICT_MAX_SIZE_BYTES=26214400
IMAGE_MAX_INPUT_PIXELS=40000000
# Max retries per image for inference worker
WORKER_INFERENCE_MAX_IMAGE_ATTEMPTS=3
