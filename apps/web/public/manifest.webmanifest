{
  "name": "AgroLens",
  "short_name": "AgroLens",
  "description": "Painel de uploads e análise de imagens agrícolas.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f1e5",
  "theme_color": "#264b2f",
  "icons": [
