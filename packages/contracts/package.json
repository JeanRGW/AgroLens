{
  "name": "@agrolens/contracts",
  "version": "1.0.0",
  "description": "AgroLens shared contracts, DTOs, and Zod schemas",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\" \"*.json\"",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@agrolens/eslint-config": "workspace:*",
    "@agrolens/tsconfig": "workspace:*",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  }
}
